{
  "manifest_version": 3,
  "name": "PM Interview Dual-Provider Runtime",
  "version": "0.2.0",
  "description": "Durable dual-provider text and voice interview runtime for managed ChatGPT and Claude windows launched by AutoHotkey.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/signals/claude-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/entry.js",
        "content/runtime.js",
        "content/status-overlay.js",
        "content/adapters/*.js",
        "shared/*.js",
        "content/signals/*.js",
        "content/observation/*.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ]
    }
  ]
}