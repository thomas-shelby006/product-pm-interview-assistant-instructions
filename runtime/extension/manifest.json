{
  "manifest_version": 3,
  "name": "PM Interview Dual-Provider Runtime",
  "version": "0.7.0",
  "description": "Low-latency self-healing PM interview runtime with a live Runtime Pilot Dashboard, bounded final queue, ephemeral session state, background-safe recovery, provisional previews, and provider-rendered delivery proof.",
  "permissions": [
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/signals/claude-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/entry.js",
        "content/runtime.js",
        "content/answer-tracker.js",
        "content/status-overlay.js",
        "content/adapters/*.js",
        "shared/*.js",
        "content/signals/*.js",
        "content/observation/*.js",
        "content/senders/*.js",
        "content/preview-scheduler.js",
        "content/runtime-recovery.js",
        "content/runtime-fatal.js",
        "content/preflight-responder.js",
        "content/runtime-telemetry.js",
        "content/adapter-health.js",
        "content/role-revocation.js",
        "content/registration-recovery.js",
        "content/sender-outbox.js",
        "content/receiver-batch-runtime.js",
        "content/runtime-role-port.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ]
    }
  ],
  "commands": {
    "export-active-pmia-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "Export the active managed PMIA session"
    }
  }
}
