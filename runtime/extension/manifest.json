{
  "manifest_version": 3,
  "name": "PM Interview Assistant",
  "version": "0.12.0",
  "description": "Fast three-window PM interview runtime with direct fan-out, provider-rendered delivery proof, compact Studio and cockpit.",
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "simple/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open PMIA Studio"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["simple/claude-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["simple/chatgpt-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
      "js": ["simple/content-main.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["simple/*.js", "simple/adapters/*.js"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"]
    }
  ]
}
